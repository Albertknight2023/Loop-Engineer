# 复制为 .env 后填写真实配置。不要把真实密钥提交到 Git。

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=0
AGNES_SCORE_BATCH_SIZE=8
GITHUB_README_CHARS=6000
GITHUB_ENRICHMENT_WORKERS=4

AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# 必填：高分项目的隔离 Clone 和运行目录，例如 D:\loop-engineer-workspace\repos
WORKSPACE_ROOT=
HIGH_SCORE_THRESHOLD=75

# 可选：提高 GitHub API 限额。
GITHUB_TOKEN=
